/*
 * Custom board with STM32G0B1CET6 (LQFP48, 512 KiB flash, 144 KiB RAM)
 *
 * SPDX-License-Identifier: Apache-2.0
 */

/dts-v1/;
#include <st/g0/stm32g0b1Xe.dtsi>
#include <st/g0/stm32g0b1c(b-c-e)tx-pinctrl.dtsi>
#include <zephyr/dt-bindings/adc/adc.h>

/ {
	model = "CRSF to FSDB01 board";
	compatible = "custom,crsf-fsdb01";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
	};

	/* TODO: pin assignments are provisional until the schematic is final */
	leds: leds {
		compatible = "gpio-leds";

		green_led: led_0 {
			gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
			label = "Status LED (green)";
		};

		red_led: led_1 {
			gpios = <&gpiob 1 GPIO_ACTIVE_HIGH>;
			label = "Status LED (red)";
		};
	};

	/* TODO: placeholder pin, FS-DB01 output not assigned yet */
	fsdb01: fsdb01 {
		compatible = "flysky,fsdb01";
		out-gpios = <&gpioa 8 GPIO_ACTIVE_HIGH>;
	};

	/* Input voltage dividers: 100k over 33k, ratio 33/133 = 0.248 */
	vsense0: vsense0 {
		compatible = "voltage-divider";
		io-channels = <&adc1 0>;
		output-ohms = <33000>;
		full-ohms = <(100000 + 33000)>;
	};

	vsense1: vsense1 {
		compatible = "voltage-divider";
		io-channels = <&adc1 1>;
		output-ohms = <33000>;
		full-ohms = <(100000 + 33000)>;
	};

	aliases {
		fsdb01 = &fsdb01;
		vsense0 = &vsense0;
		vsense1 = &vsense1;
		led0 = &green_led;
		led1 = &red_led;
		crsf-uart = &usart1;
		watchdog0 = &iwdg;
	};
};

&clk_lsi {
	status = "okay";
};

&clk_hsi {
	status = "okay";
};

/* No crystal: USB is clocked from HSI48, trimmed against USB SOF by the CRS */
&clk_hsi48 {
	status = "okay";
	crs-usb-sof;
};

/* 64 MHz SYSCLK from the 16 MHz HSI */
&pll {
	div-m = <1>;
	mul-n = <8>;
	div-p = <2>;
	div-q = <2>;
	div-r = <2>;
	clocks = <&clk_hsi>;
	status = "okay";
};

&rcc {
	clocks = <&pll>;
	clock-frequency = <DT_FREQ_M(64)>;
	ahb-prescaler = <1>;
	apb1-prescaler = <1>;
};

zephyr_udc0: &usb {
	pinctrl-0 = <&usb_dm_pa11 &usb_dp_pa12>;
	pinctrl-names = "default";
	status = "okay";
};

/* CRSF link: 420000 baud, 8N1, full duplex */
&usart1 {
	pinctrl-0 = <&usart1_tx_pb6 &usart1_rx_pb7>;
	pinctrl-names = "default";
	current-speed = <420000>;
	status = "okay";
};

/* Voltage sense inputs: PA0 (IN0) and PA1 (IN1); ADC clock 64 MHz / 4 = 16 MHz */
&adc1 {
	pinctrl-0 = <&adc1_in0_pa0 &adc1_in1_pa1>;
	pinctrl-names = "default";
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <4>;
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	/* Max sampling time (160.5 cycles, 10 us): the dividers' source impedance is ~25k */
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};
};

&iwdg {
	status = "okay";
};
