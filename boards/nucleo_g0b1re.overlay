/*
 * NUCLEO-G0B1RE
 *
 * Console/shell on USB CDC ACM via an external USB connector wired to
 * PA12 = D+ (CN10-12), PA11 = D- (CN10-14) and GND.
 * CRSF link on USART1: PC4 = TX (Arduino D1), PC5 = RX (Arduino D0).
 * FS-DB01 signal out: PA10 (Arduino D2), placeholder.
 * Voltage sense inputs: PA0 (Arduino A0) and PA1 (Arduino A1) on ADC1.
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include <zephyr/dt-bindings/adc/adc.h>

#include "usb_console.dtsi"

/ {
	/* TODO: placeholder pin, FS-DB01 output not assigned yet */
	fsdb01: fsdb01 {
		compatible = "flysky,fsdb01";
		out-gpios = <&gpioa 10 GPIO_ACTIVE_HIGH>;
	};

	/* Input voltage dividers: 100k over 33k, ratio 33/133 = 0.248 */
	vsense0: vsense0 {
		compatible = "voltage-divider";
		io-channels = <&adc1 0>;
		output-ohms = <33000>;
		full-ohms = <(100000 + 33000)>;
	};

	vsense1: vsense1 {
		compatible = "voltage-divider";
		io-channels = <&adc1 1>;
		output-ohms = <33000>;
		full-ohms = <(100000 + 33000)>;
	};

	aliases {
		crsf-uart = &usart1;
		fsdb01 = &fsdb01;
		vsense0 = &vsense0;
		vsense1 = &vsense1;
	};
};

&usart1 {
	current-speed = <420000>;
};

/* PA0/PA1 pinctrl, clock and status come from the stock board */
&adc1 {
	#address-cells = <1>;
	#size-cells = <0>;

	/* Max sampling time (160.5 cycles, 10 us): the dividers' source impedance is ~25k */
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_MAX>;
		zephyr,resolution = <12>;
	};
};

/* PA11/PA12 are used by USB; release them from I2C2 and FDCAN1 */
&i2c2 {
	status = "disabled";
};

&fdcan1 {
	status = "disabled";
};
