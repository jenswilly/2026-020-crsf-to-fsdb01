/*
 * NUCLEO-G0B1RE
 *
 * Console/shell on USB CDC ACM via an external USB connector wired to
 * PA12 = D+ (CN10-12), PA11 = D- (CN10-14) and GND.
 * CRSF link on USART1: PC4 = TX (Arduino D1), PC5 = RX (Arduino D0).
 *
 * SPDX-License-Identifier: Apache-2.0
 */

#include "usb_console.dtsi"

/ {
	aliases {
		crsf-uart = &usart1;
	};
};

&usart1 {
	current-speed = <420000>;
};

/* PA11/PA12 are used by USB; release them from I2C2 and FDCAN1 */
&i2c2 {
	status = "disabled";
};

&fdcan1 {
	status = "disabled";
};
